# Copy to .env.local and fill in locally. This repo is PUBLIC — never commit values.
# Names follow the previous WeO frontend build so its values can be reused.

# Backend host (weo-3.0). The client appends /api.
#   local:  http://localhost:3002   (npm run dev in weo-3.0)
#   remote: https://dev.weo.ai
VITE_API_URL=http://localhost:3002

# O-Wallet identity provider (OAuth2 authorization code + PKCE)
VITE_WALLET_URL=https://wallet.ocono.me
VITE_OAUTH_AUTHORIZE_PATH=/api/oauth/authorize
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback
VITE_OAUTH_SCOPE=profile

# DEV | PROD
VITE_ENV=DEV

# Dev only: access token minted with `npm run dev:token` in weo-3.0.
# Ignored in production builds.
VITE_DEV_ACCESS_TOKEN=
