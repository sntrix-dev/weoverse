# Copy to .env.local and fill in locally. This repo is public — never commit values.

# Backend base URL (weo-3.0, `npm run dev` → :3002)
VITE_API_BASE_URL=http://localhost:3002/api

# OAuth (PKCE) against the IdP — values from the previous frontend build / backend .env
VITE_AUTH_SERVER=
VITE_O_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# Dev only: access token minted with `npm run dev:token` in weo-3.0 (ignored in production builds)
VITE_DEV_ACCESS_TOKEN=
